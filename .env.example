# Public example ONLY. Put real SMTP credentials in .env.smtp.local (gitignored, 0600).
# Default local capture: no external SMTP connection/verify/send.
# WP02 local mail capture is implemented; external SMTP needs separate configuration review.
WP02_MAIL_MODE=capture
WP02_PUBLIC_BASE_URL=http://127.0.0.1:19501
WP02_CAPTURE_SMTP_HOST=127.0.0.1
WP02_CAPTURE_SMTP_PORT=19506
WP02_CAPTURE_INBOX_HOST=127.0.0.1
WP02_CAPTURE_INBOX_PORT=19507
WP02_CAPTURE_FROM=researchhub@example.test

# Future external SMTP values, not authorized/enabled by filling them in.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
