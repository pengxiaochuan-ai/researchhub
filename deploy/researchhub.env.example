# REVIEW TEMPLATE ONLY. Blank values deliberately fail validation.
# This is not a production-ready configuration or authorization to migrate.
# Read server/research-runtime/README.md and the deployment admission first.
DEPLOYMENT_PRODUCT=researchhub
NODE_ENV=production
HUB_RUNTIME_PROFILE=full
HUB_REQUIRE_PRIVATE_CORE=true
HUB_CORE_DIR=/opt/researchhub/core
HUB_CORE_MANIFEST_SHA256=
DEPLOYMENT_ID=
ALLOWED_TENANT_IDS=
DEFAULT_TENANT_ID=
DATABASE_URL=
DIRECT_URL=
HUB_DATABASE_NAME=
HUB_DATABASE_APP_ROLE=
HUB_DATABASE_OWNER_ROLE=
HUB_DATABASE_MARKER_SHA256=
HUB_MANAGED_SCHEMAS=
HUB_SCHEMA_FINGERPRINT=
JWT_SECRET=
AUTH_COOKIE_NAME=
HUB_APP_ORIGIN=https://hub.pengxc.com
HUB_AUTH_COOKIE_SECURE=true
# Inside container; publish only on host loopback / approved private network.
HUB_API_HOST=0.0.0.0
HUB_API_PORT=19612
HUB_API_AUTHORITY=
HUB_SOURCE_REVIEWER_ACCOUNT_ID=
CONTROL_PLANE_ENABLED=false
ENABLED_WORKER_KINDS=
OFFICIAL_JOB_KINDS=

# Pre-provisioned dedicated bucket; startup probes only, never creates.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# No implicit paid calls, external embeddings or fake model responses.
HUB_PAID_AI_ENABLED=false
HUB_EMBEDDING_MODE=keyword-only
# KB_EMBED_URL= (required only for explicitly admitted service mode)
# KB_DOC_PARSER_URL= (explicit parser configuration and acceptance required)

# disabled: no challenge/invitation writes and HTTP503 for mail actions.
# Production SMTP is not implemented/accepted in this delivery stage.
HUB_MAIL_MODE=disabled
# Local synthetic capture ONLY, not valid for HTTPS production:
# HUB_MAIL_MODE=capture
# HUB_MAIL_DATA_DIR=/absolute/private/mail
# HUB_CAPTURE_SMTP_PORT=19656
# HUB_CAPTURE_INBOX_PORT=19657
# HUB_INVITATION_READER_ROLE_ID= (validated existing minimal role, no auto grants)

# Frontend build-time value, matching the deployed tenant slug.
VITE_AUTH_TENANT_SLUG=
# Optional Markdown export; enable only after separate deployment acceptance.
# This rehearsal keeps exports disabled and makes no export request.
HUB_ASSET_MARKDOWN_EXPORT_ENABLED=false
