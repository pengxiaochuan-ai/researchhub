# Documentation template ONLY; no credentials and no automatic database migrations.
# Current standalone research runtime supports a subset of the local full site.
# See docs/technical/repository-and-database-delivery-2026-11-18.md before deployment.
DEPLOYMENT_PRODUCT=researchhub
DEPLOYMENT_ID=
ALLOWED_TENANT_IDS=
DEFAULT_TENANT_ID=
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
AUTH_COOKIE_NAME=
HUB_APP_ORIGIN=https://hub.pengxc.com
HUB_AUTH_COOKIE_SECURE=true
HUB_API_HOST=127.0.0.1
HUB_API_PORT=19612
CONTROL_PLANE_ENABLED=false
ENABLED_WORKER_KINDS=
OFFICIAL_JOB_KINDS=

# Frontend build-time values (do not use localhost synthetic identities).
VITE_AUTH_TENANT_SLUG=

# External SMTP/model/worker/storage credentials are supplied separately by
# secret management after their specific configuration is reviewed.
